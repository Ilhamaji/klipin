# Express API
APP_PORT=5000

# PostgreSQL / Supabase
# Supabase pooler normally uses port 6543; direct connection uses 5432.
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=6543
# Supabase requires SSL. Set to false only for a local PostgreSQL without SSL.
DB_SSL=true

# JWT
JWT_SECRET=replace-with-a-long-random-string

# URL of the FastAPI AI service (with or without a trailing slash).
FASTAPI_URL=http://localhost:7860

# Timeouts in milliseconds.
# Search is intentionally below Netlify's ~10s function budget.
AI_TIMEOUT_MS=9000
AI_SUMMARIZE_TIMEOUT_MS=55000