# FastAPI / Gradio
PORT=7860

# Search source (default: SerpAPI Google Scholar)
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_URL=https://serpapi.com/search
SERPAPI_ENGINE=google_scholar
SERPAPI_NUM=10
SERPAPI_TOP_K=5
SIMILARITY_THRESHOLD=0.85

# LLM summarization
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
SUMMARY_MAX_BODY_WORDS=1000
SUMMARY_MAX_BIB_WORDS=200
SUMMARY_MAX_OUTPUT_TOKENS=1300
GROQ_MAX_RETRIES=3
GROQ_RETRY_BASE_SECONDS=2

# PostgreSQL / Supabase
# Option A: fill the five variables below.
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_NAME=postgres
DB_PORT=6543
# Option B: ignore the five variables above and set a full SQLAlchemy URL.
# DATABASE_URL=postgresql+psycopg2://user:password@host:6543/postgres?sslmode=require