# AI model files are stored with Git LFS; keep the working copies ignored by
# normal Git so a missing `git lfs` install does not add 500+ MB as plain blobs.
# (They are explicitly added with `git add` below, which respects .gitattributes.)
# ai-service/src/models/*.pkl

# Generated documentation PDFs (render from docs/src, see docs/README.md)
docs/*.pdf

# Logs and local tooling
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build/temp
tmp/
temp/